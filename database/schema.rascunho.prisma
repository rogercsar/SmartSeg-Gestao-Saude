// RASCUNHO GERADO AUTOMATICAMENTE a partir das 79 tabelas do protótipo (referencia-base44/base44/entities).
// NÃO aplicar direto. Para cada modelo: (1) se a tabela já existe no SmartSeg (marcada MAPEAR), acrescentar só os campos novos;
// (2) trocar Json por relações/tabelas quando fizer sentido; (3) definir obrigatoriedade, índices e chaves estrangeiras reais;
// (4) "org_id" representa o cliente (tenant) — usar o mecanismo de tenant que o SmartSeg já tem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// MAPEAR para Agenda de exames existente — origem: Agendamento
model Agendamento {
  id          String   @id @default(cuid())
  clinicaId String @map("clinica_id")  /// Clínica
  companyId String? @map("company_id")  /// Empresa
  empresaNome String? @map("empresa_nome")  /// Empresa (nome)
  trabalhadorId String? @map("trabalhador_id")  /// Colaborador
  trabalhadorNome String @map("trabalhador_nome")  /// Colaborador (nome)
  cpf String?  /// CPF
  cargoNome String? @map("cargo_nome")  /// Cargo
  tipoAso String? @map("tipo_aso")  /// Tipo de ASO | valores: admissional, periodico, retorno, mudanca_risco, demissional
  data DateTime @db.Date  /// Data
  hora String?  /// Hora
  duracaoMin Float? @map("duracao_min")  /// Duração (min)
  profissionalId String? @map("profissional_id")  /// Médico
  sala String?  /// Sala
  status String?  /// Status | valores: agendado, confirmado, chegou, em_atendimento, concluido, faltou, cancelado
  financeiro Json?  /// Financeiro: {tipo: contrato|kit|avulso, valor, pago, guia_codigo, observacao}
  origem String?  /// Origem | valores: manual, convocacao
  atendimentoId String? @map("atendimento_id")  /// Atendimento
  observacao String?  /// Observação
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  @@index([companyId])
  @@index([trabalhadorId])
}

/// MAPEAR para Anexos de Documentos existente — origem: Anexo
model Anexo {
  id          String   @id @default(cuid())
  companyId String? @map("company_id")  /// Empresa
  vinculoTipo String? @map("vinculo_tipo")  /// Vinculado a | valores: empresa, setor, risco, medicao, equipamento, programa, trabalhador
  vinculoId String? @map("vinculo_id")  /// ID do vínculo
  categoria String?  /// Categoria | valores: fispq, certificado_calibracao, laudo_laboratorio, ca_epi, certificado_treinamento, art_rrt, documento_assinado, foto, aso, rg_cpf, ctps, comprovante_residencia, diploma, outro
  nome String  /// Nome
  descricao String?  /// Descrição
  fileUri String @map("file_uri")  /// Arquivo (privado)
  mime String?  /// Tipo do arquivo
  tamanho Float?  /// Tamanho (bytes)
  incluirNoDocumento Boolean? @map("incluir_no_documento")  /// Listar nos anexos do documento
  orgId String? @map("org_id")  /// Organização
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  @@index([orgId])
  @@index([companyId])
}

